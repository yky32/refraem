default_platform(:mac)

SCHEME = "Refraem"
PROJECT = "Refraem.xcodeproj"

def project_root
  File.expand_path("..", __dir__)
end

def dist_app
  File.join(project_root, "build", "Refraem.app")
end

def dmg_path
  File.join(project_root, "build", "Refraem.dmg")
end

def versioned_dmg_path
  File.join(project_root, "build", "Refraem-#{marketing_version}-#{build_number}.dmg")
end

def api_key_path
  File.join(Dir.home, ".appstoreconnect", "api_key.p8")
end

def app_identifier_value
  ENV["APP_IDENTIFIER"].to_s.strip
end

def fastlane_team_id
  id = ENV["FASTLANE_TEAM_ID"].to_s.strip
  UI.user_error!("Set FASTLANE_TEAM_ID (GitHub Secret or fastlane/.env)") if id.empty?
  id
end

def prepare_api_key_file!
  p8 = ENV["APP_STORE_CONNECT_API_KEY_P8"].to_s
  return if p8.strip.empty?

  FileUtils.mkdir_p(File.dirname(api_key_path))
  File.write(api_key_path, p8)
  File.chmod(0o600, api_key_path)
end

def build_api_key
  prepare_api_key_file!
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
  UI.user_error!("Missing APP_STORE_CONNECT_API_KEY_ID / ISSUER_ID") if key_id.empty? || issuer_id.empty?
  UI.user_error!("Missing App Store Connect .p8 (APP_STORE_CONNECT_API_KEY_P8 or ~/.appstoreconnect/api_key.p8)") unless File.exist?(api_key_path)
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: api_key_path,
    duration: 1200,
    in_house: false
  )
end

def marketing_version
  tag = ENV["GITHUB_REF_NAME"].to_s.strip.sub(/^v/i, "")
  return tag unless tag.empty?

  File.read(File.join(project_root, "VERSION")).strip
rescue
  "0.1.0"
end

def build_number
  ENV["BUILD_NUMBER"].to_s.strip.empty? ? Time.now.utc.strftime("%Y%m%d%H%M") : ENV["BUILD_NUMBER"].to_s.strip
end

def run_package!(output_app: dist_app)
  ENV["MARKETING_VERSION"] = marketing_version
  ENV["BUILD_NUMBER"] = build_number
  sh("cd #{project_root.shellescape} && ./scripts/build-app.sh #{output_app.shellescape}")
  UI.user_error!("Missing #{output_app}") unless File.directory?(output_app)
end

def create_dmg!
  sh("which create-dmg")
  sh(
    "create-dmg",
    "--volname", "Refraem",
    "--window-pos", "200", "120",
    "--window-size", "600", "400",
    "--icon-size", "128",
    "--icon", "Refraem.app", "150", "200",
    "--hide-extension", "Refraem.app",
    "--app-drop-link", "450", "200",
    dmg_path,
    dist_app
  )
end

platform :mac do
  desc "Swift build → Refraem.app (ad-hoc unless CODE_SIGN_IDENTITY is set)"
  lane :package do
    run_package!
    UI.success("Packaged #{dist_app} (#{marketing_version} #{build_number})")
  end

  desc "Package and copy to ~/Applications/Refraem.app"
  lane :install do
    run_package!
    dest = File.expand_path("~/Applications/Refraem.app")
    sh("rm -rf #{dest.shellescape}")
    sh("cp -R #{dist_app.shellescape} #{dest.shellescape}")
    UI.success("Installed #{dest}")
  end

  desc "Developer ID sign + notarize + staple (needs GitHub Secrets / fastlane/.env)"
  lane :notarize_release do
    UI.user_error!("Set APP_IDENTIFIER") if app_identifier_value.empty?
    identity = ENV["CODE_SIGN_IDENTITY"].to_s.strip
    UI.user_error!("Set CODE_SIGN_IDENTITY") if identity.empty?
    run_package!
    api_key = build_api_key
    notarize(
      api_key: api_key,
      app_path: dist_app,
      print_log: true,
      staple: true
    )
    UI.success("Notarized #{dist_app}")
  end

  desc "DMG from packaged app (brew install create-dmg)"
  lane :dmg do
    package unless File.directory?(dist_app)
    create_dmg!
    UI.success("DMG: #{dmg_path}")
  end

  desc "CI release: sign, notarize, staple, versioned DMG for GitHub Releases"
  lane :release_dmg do
    UI.user_error!("Set APP_IDENTIFIER secret") if app_identifier_value.empty?
    identity = ENV["CODE_SIGN_IDENTITY"].to_s.strip
    UI.user_error!("Set CODE_SIGN_IDENTITY secret") if identity.empty?

    run_package!
    api_key = build_api_key
    notarize(
      api_key: api_key,
      app_path: dist_app,
      print_log: true,
      staple: true
    )
    create_dmg!
    sh("mv -f #{dmg_path.shellescape} #{versioned_dmg_path.shellescape}")
    UI.success("Release DMG: #{versioned_dmg_path}")
  end

  desc "Zip packaged app"
  lane :zip_release do
    package unless File.directory?(dist_app)
    zip = File.join(project_root, "build", "Refraem-#{marketing_version}-#{build_number}.zip")
    sh("cd #{File.join(project_root, 'build').shellescape} && ditto -c -k --sequesterRsrc --keepParent Refraem.app #{File.basename(zip).shellescape}")
    UI.success("Zip: #{zip}")
  end

  desc "Mac App Store / TestFlight (requires Refraem.xcodeproj)"
  lane :upload_testflight do
    UI.user_error!("Set APP_IDENTIFIER") if app_identifier_value.empty?
    project = File.join(project_root, PROJECT)
    unless File.directory?(project)
      UI.user_error!("Missing #{PROJECT}. Use release_dmg for open-source SwiftPM builds.")
    end
    api_key = build_api_key
    build_mac_app(
      project: project,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_team_id: fastlane_team_id,
      output_directory: File.join(project_root, "build"),
      output_name: "Refraem.pkg"
    )
    upload_to_testflight(
      api_key: api_key,
      app_identifier: app_identifier_value,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      uses_non_exempt_encryption: false
    )
    UI.success("Uploaded #{app_identifier_value} to TestFlight (Mac)")
  end
end
