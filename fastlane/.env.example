# Copy to fastlane/.env (gitignored). For CI, set the same names as GitHub repository Secrets.

APP_IDENTIFIER=
FASTLANE_TEAM_ID=
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_P8=
CODE_SIGN_IDENTITY=

# Local-only alternative to APP_STORE_CONNECT_API_KEY_P8:
# save key as ~/.appstoreconnect/api_key.p8

# CI certificate import (GitHub Secrets only — not in .env on laptop unless you run release locally):
# APPLE_CERTIFICATE_BASE64=
# APPLE_CERTIFICATE_PASSWORD=
# KEYCHAIN_PASSWORD=
